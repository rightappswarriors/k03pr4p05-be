  ACTIVE
  DEPLETED
  EXPIRED
  DAMAGED
}

/// FIFO-consumable batches for a Supplier's own inventory. Parallel to
/// StockBatch (which is Item/retailer-scoped) — kept separate rather than
/// reused, since a supplier's warehouse stock and a retailer's shelf stock
/// are different sides of the same transaction and shouldn't share a table.
model SupplierStockBatch {
  id             String                   @id @default(cuid())
  supplierItemId String
  warehouseId    String?
  batchNumber    String?
  quantity       Float // Soriginal received quantity
  remainingQty   Float // decremented as FIFO consumption happens
  unitCost       Float // cost per unit for this batch — this IS the FIFO cost basis
  expiryDate     DateTime?
  receivedAt     DateTime                 @default(now())
  status         SupplierStockBatchStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  supplierItem SupplierItem                @relation(fields: [supplierItemId], references: [id])
  warehouse    SupplierWarehouse?          @relation(fields: [warehouseId], references: [id])
  movements    SupplierInventoryMovement[]

  @@index([supplierItemId, status])
  @@index([supplierItemId, expiryDate])
  @@index([warehouseId])
}

enum SupplierInventoryMovementType {
  RECEIVED
  SOLD
  RESERVED
  RELEASED
  TRANSFERRED_OUT
  TRANSFERRED_IN
  ADJUSTED
  RETURNED
  DAMAGED
  EXPIRED
}

/// Append-only ledger — mirrors the WalletLedgerEntry pattern already used
/// elsewhere in this schema. This is the audit trail AND the source of truth
/// for reservedQty/damagedQty/returnedQty/availableQty on SupplierItem; those
/// fields are a cached rollup, reconciled against this table, never edited
/// in place — post a corrective movement instead.
model SupplierInventoryMovement {
  id              String                        @id @default(cuid())
  supplierItemId  String
  warehouseId     String?
  batchId         String? // null for non-batch-specific adjustments
  type            SupplierInventoryMovementType
  quantity        Float // always positive; `type` conveys direction
  quantityBefore  Float
  quantityAfter   Float
  unitCost        Float? // cost snapshot, relevant for RECEIVED/valuation
  referenceType   String? // e.g. "PurchaseOrder", "MandateTransaction", "Manual"
  referenceId     String?
  transferGroupId String? // pairs a TRANSFERRED_OUT with its TRANSFERRED_IN
  reason          String?
  createdById     Int?
  createdAt       DateTime                      @default(now())
  deletedAt       DateTime?

  supplierItem SupplierItem        @relation(fields: [supplierItemId], references: [id])
  warehouse    SupplierWarehouse?  @relation(fields: [warehouseId], references: [id])
  batch        SupplierStockBatch? @relation(fields: [batchId], references: [id])

  @@index([supplierItemId, createdAt])
  @@index([supplierItemId, type])
  @@index([transferGroupId])
}

enum SupplierIncomingStatus {
  PENDING
  RECEIVED
  CANCELLED
}

/// Lightweight expected-shipment tracking — deliberately not a full upstream
/// procurement/PO system (that would be a much bigger feature: the supplier
/// placing orders with THEIR OWN vendors). This just lets a supplier log
/// "X units arriving on Y date from Z source" so the Incoming Stock KPI and
/// forecast have real data instead of a placeholder.
model SupplierIncomingStock {
  id              String                 @id @default(cuid())
  supplierItemId  String
  warehouseId     String?
  expectedQty     Float
  expectedDate    DateTime?
  sourceLabel     String?
  status          SupplierIncomingStatus @default(PENDING)
  receivedBatchId String? // set once marked received, links to the SupplierStockBatch created
  notes           String?
  createdById     Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  supplierItem SupplierItem       @relation(fields: [supplierItemId], references: [id])
  warehouse    SupplierWarehouse? @relation(fields: [warehouseId], references: [id])

  @@index([supplierItemId, status])
}

model SupplierItemPriceHistory {
  id String @id @default(cuid())

  supplierItemId String

  oldPrice Float

  newPrice Float

  effectiveAt DateTime @default(now())

  changedById Int?

  reason String?

  supplierItem SupplierItem @relation(fields: [supplierItemId], references: [id])

  @@index([supplierItemId, effectiveAt])
}

model SupplierItemCostHistory {
  id String @id @default(cuid())

  supplierItemId String

  oldCost Float

  newCost Float

  effectiveAt DateTime @default(now())

  changedById Int?

  reason String?

  supplierItem SupplierItem @relation(fields: [supplierItemId], references: [id])
}

model PriceTier {
  id             String       @id @default(cuid())
  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)
  minQty         Int
  price          Float
}

model SupplierItemReview {
  id                 String    @id @default(cuid())
  supplierItemId     String
  reviewerOrgId      Int
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  supplierItem SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)
  reviewer     Organization @relation("SupplierItemReviewReviewer", fields: [reviewerOrgId], references: [id])

  @@index([supplierItemId])
  @@index([reviewerOrgId])
  @@index([rating])
}

model OrganizationReview {
  id                    String    @id @default(cuid())
  organizationId        Int
  reviewerOrgId         Int?
  reviewerCustomerId    Int?
  reviewerName          String?
  rating                Int
  title                 String?
  comment               String?
  isVerifiedTransaction Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization Organization  @relation("OrganizationReviewsReceived", fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     Organization? @relation("OrganizationReviewsWritten", fields: [reviewerOrgId], references: [id])

  @@index([organizationId])
  @@index([reviewerOrgId])
  @@index([reviewerCustomerId])
  @@index([rating])
}

model ReceivedItemMap {
  id             String       @id @default(cuid())
  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id])
  buyerOrgId     Int
  buyerOrg       Organization @relation("BuyerReceivedItemMaps", fields: [buyerOrgId], references: [id])
  itemId         Int
  item           Item         @relation("ReceivedItemMaps", fields: [itemId], references: [id])
  outletId       Int?
  outlet         Outlet?      @relation(fields: [outletId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([supplierItemId, buyerOrgId, outletId])
}

model PurchaseOrder {
  id            String       @id @default(cuid())
  poNumber      String       @unique
  buyerOrgId    Int
  buyerOrg      Organization @relation("BuyerOrg", fields: [buyerOrgId], references: [id])
  supplierOrgId Int
  supplierOrg   Organization @relation("SupplierOrg", fields: [supplierOrgId], references: [id])
  outletId      Int
  outlet        Outlet       @relation(fields: [outletId], references: [id])
  status        POStatus     @default(PENDING)
  lineItems     POLineItem[]
  delivery      Delivery?
  notes         String?
  requestedDate DateTime?
  totalAmount   Float
  vatAmount     Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model POLineItem {
  id             String        @id @default(cuid())
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id])
  supplierItemId String
  supplierItem   SupplierItem  @relation(fields: [supplierItemId], references: [id])
  qty            Int
  unitPrice      Float
  subtotal       Float
}

model Delivery {
  id            String         @id @default(cuid())
  poId          String         @unique
  po            PurchaseOrder  @relation(fields: [poId], references: [id])
  scheduledDate DateTime
  deliveredAt   DateTime?
  status        DeliveryStatus @default(SCHEDULED)
  driverName    String?
  driverContact String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SupplierOutletLink {
  id            String       @id @default(cuid())
  supplierOrgId Int
  supplierOrg   Organization @relation("SupplierLinks", fields: [supplierOrgId], references: [id])
  outletId      Int
  outlet        Outlet       @relation(fields: [outletId], references: [id])
  isApproved    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@unique([supplierOrgId, outletId])
}

enum Environment {
  SANDBOX
  PRODUCTION
}

/// Generic runtime config / feature-flag store. Read through a cached
/// service (Redis-backed) so toggling doesn't require a redeploy.
/// Seed rows: subscriptionBillingEnabled, kycEnforcementProdOnly,
/// visibilityMatrixEnabled, defaultPaymentEnvironment.
model SystemConfig {
  id          String    @id @default(cuid())
  key         String    @unique
  value       Json
  description String?
  updatedAt   DateTime  @updatedAt
  updatedById Int?
  deletedAt   DateTime?
}

// ────────────────────────────────────────────────────────────────────────
// KYC / BUSINESS VERIFICATION
// ────────────────────────────────────────────────────────────────────────

enum DocumentType {
  BUSINESS_PERMIT
  DTI_SEC_REGISTRATION
  BIR_2303
  VALID_ID
  PROOF_OF_ADDRESS
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  BYPASSED_DEV // auto-set when environment = SANDBOX and KYC enforcement is off
}

// ────────────────────────────────────────────────────────────────────────
// VERIFICATION REQUIREMENTS — admin-configured, per document type.
// Drives both "what documents does a supplier need to submit" (progress
// card) and "how long does an approval stay valid" (expiration/renewal).
// Versioned like FeeRule elsewhere in this schema: don't edit validityDays
// in place if requirements change after suppliers are already verified
// under the old period — insert a new row and set isActive on the old one
// to false, so historical expirations stay explainable.
// ────────────────────────────────────────────────────────────────────────
model VerificationRequirement {
  id                 String       @id @default(cuid())
  documentType       DocumentType
  label              String // display name, e.g. "Business Permit"
  description        String?
  isRequired         Boolean      @default(true)
  validityDays       Int? // null = does not expire
  reminderDaysBefore Int[]        @default([90, 30, 14, 7]) // configurable, not hardcoded to exactly these
  isActive           Boolean      @default(true)
  createdById        Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  documents BusinessVerificationDocument[]

  @@unique([documentType, isActive])
  @@index([isActive])
}

// ────────────────────────────────────────────────────────────────────────
// BUSINESS VERIFICATION DOCUMENT — supersedes BusinessVerification.
// One row per uploaded document (a resubmission after rejection creates
// a new row rather than overwriting, so document history and review
// history both stay intact without extra joins).
// ────────────────────────────────────────────────────────────────────────
model BusinessVerificationDocument {
  id            String             @id @default(cuid())
  orgId         Int
  requirementId String
  documentType  DocumentType
  fileUrl       String // public URL, from MediaService
  filePath      String // storage path, from MediaService — required for delete/replace
  status        VerificationStatus @default(PENDING)
  uploadedAt    DateTime           @default(now())
  approvedAt    DateTime?
  expiresAt     DateTime? // computed at approval time from requirement.validityDays
  reviewedById  Int?
  reviewedAt    DateTime?
  adminRemarks  String?
  environment   Environment        @default(PRODUCTION)
  isSuperseded  Boolean            @default(false) // true once replaced by a newer upload of the same type
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  organization Organization                @relation(fields: [orgId], references: [id])
  requirement  VerificationRequirement     @relation(fields: [requirementId], references: [id])
  reviews      VerificationReviewHistory[]

  @@index([orgId, status])
  @@index([orgId, documentType])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────
// REVIEW HISTORY — append-only. Every status change (approve, reject,
// re-review after resubmission) gets its own row rather than overwriting
// the document's reviewedAt/adminRemarks, so the Review History timeline
// on the dashboard has something real to render.
// ────────────────────────────────────────────────────────────────────────
model VerificationReviewHistory {
  id           String             @id @default(cuid())
  documentId   String
  status       VerificationStatus
  remarks      String?
  reviewedById Int?
  reviewedAt   DateTime           @default(now())

  document BusinessVerificationDocument @relation(fields: [documentId], references: [id])

  @@index([documentId, reviewedAt])
}

// ────────────────────────────────────────────────────────────────────────
// Organization gets the renamed relation + a denormalized rollup for fast
// "is this org currently verified" checks without aggregating documents
// on every read (mirrors the SupplierItem.currentCost caching pattern
// used elsewhere in this schema).
// ────────────────────────────────────────────────────────────────────────
// Add to Organization model:
//   businessVerificationDocuments BusinessVerificationDocument[]
//   verificationStatus            OrgVerificationStatus @default(UNVERIFIED)
//   verificationExpiresAt         DateTime?

enum OrgVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
}

// ────────────────────────────────────────────────────────────────────────
// MANDATE / AGENT (kompra.ph demand side)
// ────────────────────────────────────────────────────────────────────────

enum AgentType {
  ORG_LINKED
  STANDALONE
}

/// A Mandate/Agent user. If agentType = ORG_LINKED, organizationId points at
/// an existing, verified Organization (resolved during registration search).
/// If STANDALONE, organizationId is null and the agent carries its own
/// identity + verification instead of an org's.
model Agent {
  id                 String             @id @default(cuid())
  agentType          AgentType
  organizationId     Int?
  fullname           String
  email              String             @unique
  phone              String?
  passwordHash       String
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  trustTier          String             @default("FREE") // matches SubscriptionPlan-style tiering for Phase 2 visibility matching
  environment        Environment        @default(PRODUCTION)
  isDevSeed          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  organization  Organization?       @relation(fields: [organizationId], references: [id])
  verifications AgentVerification[]
  mandates      Mandate[]

  @@index([organizationId])
  @@index([agentType, verificationStatus])
}

/// ID / clearance uploads for STANDALONE agents (and org-linked agents who
/// still need personal ID confirmation before acting on behalf of the org).
model AgentVerification {
  id           String             @id @default(cuid())
  agentId      String
  documentType DocumentType
  fileUrl      String
  status       VerificationStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  environment  Environment        @default(PRODUCTION)
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId, status])
}

enum MandateStatus {
  DRAFT
  SEARCHING
  SENT
  OFFERED
  ACCEPTED
  FUNDED
  SETTLED
  COMPLETED
  DISPUTED
  CANCELLED
}

/// A demand request created by an Agent. lat/lng + radiusKm drive the
/// Google-Maps-backed supplier search (mirrors OutletItemSearchIndex's
/// lat/lng pattern already used elsewhere in this schema).
model Mandate {
  id          String        @id @default(cuid())
  agentId     String
  category    String
  unitType    String // e.g. "liter" for fuel
  quantity    Float
  targetPrice Float?
  latitude    Float?
  longitude   Float?
  radiusKm    Float?        @default(10)
  status      MandateStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  agent       Agent               @relation(fields: [agentId], references: [id])
  offers      MandateOffer[]
  transaction MandateTransaction?

  @@index([agentId, status])
  @@index([category, unitType])
}

enum MandateOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model MandateOffer {
  id            String             @id @default(cuid())
  mandateId     String
  supplierOrgId Int
  price         Float
  availableQty  Float
  terms         String?
  status        MandateOfferStatus @default(PENDING)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  mandate     Mandate      @relation(fields: [mandateId], references: [id])
  supplierOrg Organization @relation("SupplierMandateOffers", fields: [supplierOrgId], references: [id])

  @@index([mandateId, status])
  @@index([supplierOrgId, status])
}

// ────────────────────────────────────────────────────────────────────────
// WALLET / LEDGER (shared by Retailer + Supplier orgs)
// ────────────────────────────────────────────────────────────────────────

/// One wallet per Organization (works for orgs with SELLER role, SUPPLIER
/// role, or both — money in from retail checkout AND mandate settlement
/// lands in the same place).
model Wallet {
  id          Int       @id @default(autoincrement())
  orgId       Int       @unique
  balance     Float     @default(0) // available, withdrawable
  heldBalance Float     @default(0) // Phase 2 escrow: funds in transit, not yet released
  currency    String    @default("PHP")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization  Organization        @relation(fields: [orgId], references: [id])
  ledgerEntries WalletLedgerEntry[]
  withdrawals   Withdrawal[]
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerSourceType {
  RETAIL_ORDER
  MANDATE_TRANSACTION
  WITHDRAWAL
  SUBSCRIPTION_FEE
  PLATFORM_FEE
  ADJUSTMENT
  ESCROW_HOLD
  ESCROW_RELEASE
}

enum LedgerEntryStatus {
  HELD // Phase 2 escrow: posted but not withdrawable yet
  AVAILABLE
  RELEASED
  REVERSED
}

/// Append-only. Never update amount/type on an existing row — post a
/// REVERSED counter-entry instead. Background job verifies wallet.balance
/// always equals the sum of AVAILABLE ledger entries for that wallet.
model WalletLedgerEntry {
  id           Int               @id @default(autoincrement())
  walletId     Int
  type         LedgerEntryType
  sourceType   LedgerSourceType
  referenceId  String? // id of the SalesOrder / KompraCOrder / MandateTransaction / Withdrawal etc.
  amount       Float
  balanceAfter Float
  status       LedgerEntryStatus @default(AVAILABLE)
  environment  Environment       @default(PRODUCTION)
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([sourceType, referenceId])
}

enum PayoutMethodType {
  BANK_TRANSFER
  GCASH
  PAYMAYA
  CHECK
}

model PayoutMethod {
  id                  Int              @id @default(autoincrement())
  orgId               Int
  type                PayoutMethodType
  accountName         String
  maskedAccountNumber String // last 4 digits only; full details live in the bank/gateway vault, not here
  bankName            String?
  isVerified          Boolean          @default(false)
  isDefault           Boolean          @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  withdrawals  Withdrawal[]

  @@index([orgId])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

/// Maker-checker: requestedById and approvedById must differ for amounts
/// above the configurable auto-approve threshold (see SystemConfig).
model Withdrawal {
  id              Int              @id @default(autoincrement())
  walletId        Int
  payoutMethodId  Int
  amount          Float
  status          WithdrawalStatus @default(PENDING)
  requestedById   Int
  approvedById    Int?
  requestedAt     DateTime         @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  rejectionReason String?
  environment     Environment      @default(PRODUCTION)
  deletedAt       DateTime?

  wallet       Wallet       @relation(fields: [walletId], references: [id])
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])

  @@index([walletId, status])
}

// ────────────────────────────────────────────────────────────────────────
// PAYMENTS (customer checkout + mandate funding, sandbox-testable)
// ────────────────────────────────────────────────────────────────────────

enum PaymentGatewayProvider {
  PAYMONGO
  GCASH
  PAYMAYA
  BANK_API
}

/// Generalizes the existing PaymongoAPIKeys model to support multiple
/// providers AND both environments side by side, so a supplier can have a
/// SANDBOX credential set (used automatically while environment=SANDBOX)
/// and a PRODUCTION set, without ever touching the wrong one.
model PaymentGatewayCredential {
  id                 Int                    @id @default(autoincrement())
  orgId              Int? // null = platform-level default credential
  provider           PaymentGatewayProvider
  environment        Environment
  publicKey          String?
  secretKeyEncrypted String // encrypted at rest via KMS; never returned by any API
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  organization Organization? @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider, environment])
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentRelatedType {
  KOMPRA_C_ORDER
  SALES_ORDER
  MANDATE_TRANSACTION
  SUBSCRIPTION
}

/// Every online payment attempt, gateway-agnostic — this is what sandbox
/// testing exercises end-to-end (webhook in, ledger entry out) without ever
/// touching PRODUCTION credentials or counting toward real revenue.
model PaymentTransaction {
  id               String                   @id @default(cuid())
  provider         PaymentGatewayProvider
  environment      Environment
  gatewayReference String?                  @unique
  amount           Float
  feeAmount        Float                    @default(0)
  status           PaymentTransactionStatus @default(PENDING)
  relatedType      PaymentRelatedType
  relatedId        String
  payerOrgId       Int?
  payerAgentId     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  @@index([relatedType, relatedId])
  @@index([provider, environment, status])
}

// ────────────────────────────────────────────────────────────────────────
// MANDATE SETTLEMENT / ESCROW
// ────────────────────────────────────────────────────────────────────────

enum SettlementType {
  INSTANT
  ESCROW
}

enum MandateTransactionStatus {
  PENDING
  FUNDED
  SETTLED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
}

model MandateTransaction {
  id                   String                   @id @default(cuid())
  mandateId            String                   @unique
  offerId              String
  agentId              String
  supplierOrgId        Int
  amount               Float
  feeAmount            Float
  netAmount            Float
  settlementType       SettlementType           @default(INSTANT)
  status               MandateTransactionStatus @default(PENDING)
  paymentTransactionId String?
  linkedPoId           String? // optional: set when an ORG_LINKED agent's mandate also creates a PurchaseOrder for full inventory tracking
  environment          Environment              @default(PRODUCTION)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  mandate     Mandate        @relation(fields: [mandateId], references: [id])
  supplierOrg Organization   @relation("SupplierMandateTransactions", fields: [supplierOrgId], references: [id])
  escrow      EscrowRelease?

  @@index([supplierOrgId, status])
  @@index([agentId, status])
}

enum DisputeStatus {
  NONE
  RAISED
  UNDER_REVIEW
  RESOLVED
}

/// Inert while settlementType = INSTANT (Phase 1). Becomes the active
/// release-gate once escrow ships (Phase 2) — same MandateTransaction row,
/// no data migration needed to turn it on.
model EscrowRelease {
  id                   String        @id @default(cuid())
  mandateTransactionId String        @unique
  buyerProofUrl        String?
  sellerProofUrl       String?
  buyerConfirmedAt     DateTime?
  sellerConfirmedAt    DateTime?
  autoReleaseAt        DateTime?
  releasedAt           DateTime?
  disputeStatus        DisputeStatus @default(NONE)
  disputeReason        String?
  resolvedById         Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  mandateTransaction MandateTransaction @relation(fields: [mandateTransactionId], references: [id])
}

// ────────────────────────────────────────────────────────────────────────
// FEES & VISIBILITY (Phase 2 tiering — data-driven, inert until enabled)
// ────────────────────────────────────────────────────────────────────────

enum FeeApplication {
  MANDATE_TRANSACTION
  RETAIL_ORDER
}

enum FeeRateType {
  PERCENTAGE
  PER_UNIT
  FLAT
}

/// Versioned — never edit rate in place, insert a new row with a fresh
/// effectiveFrom so historical transactions stay auditable at the rate
/// that actually applied to them.
model FeeRule {
  id            String         @id @default(cuid())
  appliesTo     FeeApplication
  category      String?
  unitType      String? // e.g. "liter"
  rateType      FeeRateType
  rate          Float // e.g. 0.35 for 35 centavos per_unit, or 0.02 for 2% percentage
  tierModifier  Float?         @default(0)
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([appliesTo, category, unitType, isActive])
}

/// Phase 2 only. agentTier mirrors Agent.trustTier; supplierPlan mirrors
/// SubscriptionPlan. Search/matching service checks this table only when
/// SystemConfig["visibilityMatrixEnabled"] = true — Phase 1 search ignores it.
model VisibilityRule {
  id           String           @id @default(cuid())
  agentTier    String
  supplierPlan SubscriptionPlan
  isVisible    Boolean          @default(true)
  rankBoost    Float            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@unique([agentTier, supplierPlan])
}
