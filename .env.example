# .env 
NODE_ENV="development"
DATABASE_URL="postgresql://kompra:kompra_dev@localhost:5433/kompra_dev"
JWT_SECRET="JWT_SECRET"
REFRESH_SECRET="REFRESH_SECRET"
ENCRYPTION_KEY=secret
# EMAIL_FROM is used with Resend for email verification (default: onboarding@resend.dev)
EMAIL_FROM=onboarding@resend.dev
SMTP_PASS=replace-with-your-smtp-app-password
SMTP_USER=your-email@example.com

RESEND_API_KEY=replace-with-your-resend-api-key
FRONTEND_URL="http://localhost:8081"
REDIS_URL=redis://127.0.0.1:6379

DEFAULT_PAYMENT_ENVIRONMENT=SANDBOX
KYC_ENFORCEMENT_PROD_ONLY=false
PAYMENT_PROVIDER=MAYA
PAYMENT_ENV=SANDBOX
# Non-secret reconciliation label. This backend owns the Portal Maya application only.
MAYA_APPLICATION_CHANNEL=KOMPRA_PORTAL
# Retailer Supplier PO Cash on Delivery ceiling, in PHP.
COD_MAX_ORDER_AMOUNT_PHP=25000
# Buyer response window for an active Supplier delivery-date proposal.
DELIVERY_AGREEMENT_BUYER_RESPONSE_HOURS=24
MAYA_PUBLIC_KEY=replace-with-your-kompra-portal-maya-public-key
MAYA_SECRET_KEY=replace-with-your-kompra-portal-maya-secret-key
MAYA_SUCCESS_URL=http://localhost:8081/supplier-links/payment-return
MAYA_CANCEL_URL=http://localhost:8081/supplier-links/payment-return
# Maya Checkout is documented as valid for one hour; keep reuse below 60 minutes.
MAYA_CHECKOUT_REUSE_MINUTES=55
# During free-ngrok development, point the one hostname to this backend on port 4000.
# Register https://<current-ngrok-host>/api/payments/webhook/maya in the Portal Maya app.
# Optional override. Production defaults to Maya's documented production webhook IPs.
MAYA_WEBHOOK_ALLOWED_IPS=18.138.50.235,3.1.207.200

PAYOUT_DESTINATION_ENCRYPTION_KEY="<your-generated-base64-key>"
# Set true only for local sandbox payout testing. It is always blocked in production.
SANDBOX_SETTLEMENT_MODE=false
KOMPRA_WEB_API_URL=http://localhost:8000/api
SANDBOX_SETTLEMENT_SERVICE_KEY=replace-with-the-matching-long-random-secret
# Bounded server-to-server reconciliation relay timeout. Never expose the service key to the frontend.
SANDBOX_SETTLEMENT_TIMEOUT_MS=10000
# Server-to-server credential for PO cancellation/refund orchestration. Never expose this to Expo/browser code.
PORTAL_COMMERCE_SERVICE_KEY=replace-with-the-matching-long-random-secret
PORTAL_COMMERCE_TIMEOUT_MS=10000
